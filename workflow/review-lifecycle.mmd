---
title: Review Lifecycle
description: Manages review creation, immutable verdicts, changes-required, and re-review. The implementationComplete guard ignores only durably resolved cancel_supersede cancellations and failed Tasks with a valid superseded classification targeting succeeded work.
---
flowchart LR
%% relay: initial none
none["state: NONE"]
pending["state: PENDING"]
started["state: STARTED"]
approved["state: APPROVED"]
changes["state: CHANGES_REQUIRED"]
%% BLOCKED is only for legacy records awaiting authoritative unblock.
blocked["state: BLOCKED"]
stale["state: STALE"]

reviewEnabledNone["guard: reviewEnabled"]
jobActiveNone["guard: jobActive"]
implementationCompleteNone["guard: implementationComplete"]
headAvailableNone["guard: headAvailable"]
completionGateNone["guard: completionGateSatisfied"]
noActiveReviewNone["guard: noActiveReviewTask"]
noApprovedReviewNone["guard: noApprovedCurrentReview"]
reviewEnabledStale["guard: reviewEnabled"]
jobActiveStale["guard: jobActive"]
implementationCompleteStale["guard: implementationComplete"]
headAvailableStale["guard: headAvailable"]
completionGateStale["guard: completionGateSatisfied"]
noActiveReviewStale["guard: noActiveReviewTask"]
noApprovedReviewStale["guard: noApprovedCurrentReview"]
pendingRetry["guard: noActiveReviewTask"]
pendingCancelled["guard: currentReviewCancelled"]
pendingUnapproved["guard: noApprovedCurrentReview"]
createPendingRetry["action: review.create"]
autoMergePending["guard: autoMerge"]
autoMergeStarted["guard: autoMerge"]
createNone["action: review.create"]
createStale["action: review.create"]
cancelPending["action: review.cancelStale"]
cancelStarted["action: review.cancelStale"]
cancelApproved["action: review.cancelStale"]
cancelChanges["action: review.cancelStale"]
cancelBlocked["action: review.cancelStale"]
reviewUnblocked["guard: reviewUnblocked"]
targetedPending["guard: targetedRevisionRequestsReady"]
targetedStarted["guard: targetedRevisionRequestsReady"]
targetedChanges["guard: targetedRevisionRequestsReady"]
recordTargetedPending["action: review.awaitTargetedRevisions"]
recordTargetedStarted["action: review.awaitTargetedRevisions"]
recordTargetedChanges["action: review.awaitTargetedRevisions"]
ownerPending["action: review.requireOwnerResolution"]
ownerStarted["action: review.requireOwnerResolution"]
ownerChanges["action: review.requireOwnerResolution"]
mergePending["action: review.requestMerge"]
mergeStarted["action: review.requestMerge"]

none -->|on: reconcile| reviewEnabledNone
reviewEnabledNone -->|true| jobActiveNone
reviewEnabledNone -->|false| none
jobActiveNone -->|true| implementationCompleteNone
jobActiveNone -->|false| none
implementationCompleteNone -->|true| headAvailableNone
implementationCompleteNone -->|false| none
headAvailableNone -->|true| completionGateNone
headAvailableNone -->|false| none
completionGateNone -->|true| noActiveReviewNone
completionGateNone -->|false| none
noActiveReviewNone -->|true| noApprovedReviewNone
noActiveReviewNone -->|false| none
noApprovedReviewNone -->|true| createNone
noApprovedReviewNone -->|false| none
createNone --> pending

stale -->|on: reconcile| reviewEnabledStale
reviewEnabledStale -->|true| jobActiveStale
reviewEnabledStale -->|false| stale
jobActiveStale -->|true| implementationCompleteStale
jobActiveStale -->|false| stale
implementationCompleteStale -->|true| headAvailableStale
implementationCompleteStale -->|false| stale
headAvailableStale -->|true| completionGateStale
headAvailableStale -->|false| stale
completionGateStale -->|true| noActiveReviewStale
completionGateStale -->|false| stale
noActiveReviewStale -->|true| noApprovedReviewStale
noActiveReviewStale -->|false| stale
noApprovedReviewStale -->|true| createStale
noApprovedReviewStale -->|false| stale
createStale --> pending

pending -->|on: reconcile| pendingRetry
pendingRetry -->|true| pendingCancelled
pendingRetry -->|false| pending
pendingCancelled -->|true| pendingUnapproved
pendingCancelled -->|false| pending
pendingUnapproved -->|true| createPendingRetry
pendingUnapproved -->|false| pending
createPendingRetry --> pending

pending -->|on: review.legacy_blocked| blocked
pending -->|on: review.started| started
pending -->|on: review.approved| autoMergePending
autoMergePending -->|true| mergePending
mergePending --> approved
autoMergePending -->|false| approved
pending -->|on: review.changes_required| targetedPending
targetedPending -->|true| recordTargetedPending
targetedPending -->|false| ownerPending
recordTargetedPending --> changes
ownerPending --> changes

%% A failed Reviewer execution may recover with a new Execution ID while
%% the Review lifecycle remains STARTED. This is a legal re-start event;
%% Reconciler still fences stale execution generations and immutable head SHA.
started -->|on: review.started| started
started -->|on: review.approved| autoMergeStarted
autoMergeStarted -->|true| mergeStarted
mergeStarted --> approved
autoMergeStarted -->|false| approved
started -->|on: review.changes_required| targetedStarted
targetedStarted -->|true| recordTargetedStarted
targetedStarted -->|false| ownerStarted
recordTargetedStarted --> changes
ownerStarted --> changes
changes -->|on: review.changes_required| targetedChanges
targetedChanges -->|true| recordTargetedChanges
targetedChanges -->|false| ownerChanges
recordTargetedChanges --> changes
ownerChanges --> changes

pending -->|on: head.changed| cancelPending
cancelPending --> stale
started -->|on: head.changed| cancelStarted
cancelStarted --> stale
approved -->|on: head.changed| cancelApproved
cancelApproved --> stale
changes -->|on: revision.settled| targetedVerified
%% Only the Review Graph selects re-review; settlement is proven by correlated
%% child terminal evidence and explicit revision request provenance.
targetedVerified["guard: targetedRevisionsVerified"]
reviewRoundAllowed["guard: reviewRoundWithinLimit"]
reviewNoProgressAllowed["guard: reviewNoProgressWithinLimit"]
prepareRereview["action: review.prepareRereview"]
limitOwnerResolution["action: review.requireOwnerResolution"]
targetedVerified -->|true| reviewRoundAllowed
reviewRoundAllowed -->|true| reviewNoProgressAllowed
reviewNoProgressAllowed -->|true| prepareRereview
reviewNoProgressAllowed -->|false| limitOwnerResolution
%% Exhausted re-review rounds require explicit owner/Planner recovery.
reviewRoundAllowed -->|false| limitOwnerResolution
limitOwnerResolution --> changes
prepareRereview --> stale
changes -->|on: head.changed| cancelChanges
cancelChanges --> stale
blocked -->|on: review.retry| reviewUnblocked
reviewUnblocked -->|true| pending
reviewUnblocked -->|false| blocked
blocked -->|on: head.changed| cancelBlocked
cancelBlocked --> stale
