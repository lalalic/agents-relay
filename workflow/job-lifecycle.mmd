flowchart LR
%% relay: initial draft
draft["state: DRAFT"]
active["state: ACTIVE"]
completed["state: COMPLETED"]
cancelled["state: CANCELLED"]

cancelDraft["action: effect.cancelActiveTasks"]
cancelActive["action: effect.cancelActiveTasks"]
localCompletionGuard["guard: localCompletionAllowed"]
localMergeReadyGuard["guard: localMergeReady"]
localMergeDelivery["action: effect.deliverLocalMerge"]

draft -->|on: activate| active
draft -->|on: cancel| cancelDraft
cancelDraft --> cancelled

active -->|on: reconcile| active
active -->|on: review.approved| active
active -->|on: implementation.completed| active
active -->|on: cancel| cancelActive
cancelActive --> cancelled

active -->|on: local.completed| localCompletionGuard
localCompletionGuard -->|true| completed
localCompletionGuard -->|false| active

active -->|on: local.merge.requested| localMergeReadyGuard
localMergeReadyGuard -->|true| localMergeDelivery
localMergeDelivery --> active
localMergeReadyGuard -->|false| active
active -->|on: effect.deliverLocalMerge.failed| active

cancelled -->|on: effect.cancelActiveTasks.failed| cancelled
completed -->|on: effect.cleanupJobWorktree.failed| completed
