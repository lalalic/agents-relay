---
title: Completed Local Git Delivery
description: Optionally deliver completed local main to a usable origin with independent bounded retries.
name: projection-conflict
authority: SQLite delivery state and completed Job snapshot
trigger: job.completed or delivery.retry_due
idempotency: job-id plus local main SHA
actions:
  - delivery.skip
  - delivery.pushMain
  - delivery.recordDelivered
  - delivery.scheduleRetry
  - delivery.recordExhausted
guards:
  - delivery.originUsable
  - delivery.remoteContainsMain
  - delivery.retryAvailable
  - delivery.retryDue
---
flowchart LR
%% relay: initial classify
classify["state: classify"]
inspect["state: inspect"]
push["state: push"]
waiting["state: waiting"]
delivered["state: delivered"]
skipped["state: skipped"]
exhausted["state: exhausted"]

originUsable["guard: delivery.originUsable"]
remoteContains["guard: delivery.remoteContainsMain"]
retryAvailable["guard: delivery.retryAvailable"]
retryDue["guard: delivery.retryDue"]
skip["action: delivery.skip"]
pushMain["action: delivery.pushMain"]
recordDelivered["action: delivery.recordDelivered"]
scheduleRetry["action: delivery.scheduleRetry"]
recordExhausted["action: delivery.recordExhausted"]

classify -->|on: job.completed| originUsable
originUsable -->|false| skip
originUsable -->|true| inspect
inspect -->|on: inspect.completed| remoteContains
remoteContains -->|true| recordDelivered
remoteContains -->|false| pushMain
pushMain --> push
push -->|on: delivery.pushed| recordDelivered
push -->|on: delivery.failed| retryAvailable
retryAvailable -->|true| scheduleRetry
retryAvailable -->|false| recordExhausted
scheduleRetry --> waiting
waiting -->|on: delivery.retry_due| retryDue
retryDue -->|true| pushMain
retryDue -->|false| waiting
recordDelivered --> delivered
skip --> skipped
recordExhausted --> exhausted
