---
title: Task Lifecycle
description: Defines canonical Task transitions, dispatch guards, failure, and recovery.
---
flowchart LR
%% relay: initial draft
draft["state: DRAFT"]
queued["state: QUEUED"]
running["state: RUNNING"]
blocked["state: BLOCKED"]
succeeded["state: SUCCEEDED"]
failed["state: FAILED"]
cancelled["state: CANCELLED"]
draftBlockAllowed["guard: troubleshooterTask"]
queuedReviewBlockAllowed["guard: troubleshooterTask"]
queuedBlockAllowed["guard: troubleshooterTask"]
runningBlockAllowed["guard: troubleshooterTask"]
unblockAllowed["guard: troubleshooterTask"]
interactiveWaitAllowed["guard: awaitingInteractiveDecision"]
recoverBlockAllowed["guard: troubleshooterTask"]

depSat["guard: dependenciesSatisfied"]
depUnsat["guard: dependenciesUnsatisfied"]
runnable["guard: runnable"]
dispatchable["guard: dispatchable"]
recoverStart["guard: recoverableExecution"]
recoverComplete["guard: recoverableExecution"]
recoverBlocked["guard: recoverableExecution"]
recoverFailed["guard: recoverableExecution"]
recoverCancelled["guard: recoverableExecution"]
troubleshooterRecovery["guard: troubleshooterRecovery"]
recoveryReopenClearError["action: mutation.clearError"]
recoveryReopenClearReason["action: mutation.clearFailureReason"]
recoveryReopenClearLease["action: mutation.clearLease"]
recoveryReopenClearExecution["action: mutation.clearExecution"]

plannerRetryAvailable["guard: retryAvailable"]
plannerUnavailableMark["action: mutation.markPlannerUnavailable"]
orphanFailMark["action: mutation.markUnknownOutcome"]
orphanFailClearLease["action: mutation.clearLease"]
orphanFailClearExecution["action: mutation.clearExecution"]
plannerRetryClearError["action: mutation.clearError"]
plannerRetryClearLease["action: mutation.clearLease"]
plannerRetryClearExecution["action: mutation.clearExecution"]
plannerFailClearLease["action: mutation.clearLease"]
plannerFailClearExecution["action: mutation.clearExecution"]
leaseFailRunningMark["action: mutation.markUnknownOutcome"]
leaseFailRunningClearLease["action: mutation.clearLease"]
leaseFailRunningClearExecution["action: mutation.clearExecution"]
leaseFailQueuedMark["action: mutation.markUnknownOutcome"]
leaseFailQueuedClearLease["action: mutation.clearLease"]
leaseFailQueuedClearExecution["action: mutation.clearExecution"]

releaseClearError["action: mutation.clearError"]
releaseClearReason["action: mutation.clearFailureReason"]
reconcileDraftClearError["action: mutation.clearError"]
reconcileDraftClearReason["action: mutation.clearFailureReason"]
reconcileQueuedClearError["action: mutation.clearError"]
reconcileQueuedClearReason["action: mutation.clearFailureReason"]
dispatchLaunch["action: effect.launchTask"]
startClearError["action: mutation.clearError"]
startClearReason["action: mutation.clearFailureReason"]
reviewStartClearError["action: mutation.clearError"]
reviewStartClearReason["action: mutation.clearFailureReason"]
reviewApproveQueuedClearError["action: mutation.clearError"]
reviewApproveQueuedClearReason["action: mutation.clearFailureReason"]
reviewChangesQueuedClearError["action: mutation.clearError"]
reviewChangesQueuedClearReason["action: mutation.clearFailureReason"]
reviewApproveRunningClearError["action: mutation.clearError"]
reviewApproveRunningClearReason["action: mutation.clearFailureReason"]
reviewChangesRunningClearError["action: mutation.clearError"]
reviewChangesRunningClearReason["action: mutation.clearFailureReason"]
completeClearError["action: mutation.clearError"]
completeClearReason["action: mutation.clearFailureReason"]
unblockRetryClearError["action: mutation.clearError"]
unblockRetryClearReason["action: mutation.clearFailureReason"]
failedRetryClearError["action: mutation.clearError"]
failedRetryClearReason["action: mutation.clearFailureReason"]
recoverStartClearError["action: mutation.clearError"]
recoverStartClearReason["action: mutation.clearFailureReason"]
recoverCompleteClearError["action: mutation.clearError"]
recoverCompleteClearReason["action: mutation.clearFailureReason"]

draft -->|on: release| releaseClearError
releaseClearError --> releaseClearReason
releaseClearReason --> queued
draft -->|on: queue| depSat
draft -->|on: reconcile| depSat
depSat -->|true| reconcileDraftClearError
reconcileDraftClearError --> reconcileDraftClearReason
reconcileDraftClearReason --> queued
draft -->|on: block| draftBlockAllowed
draftBlockAllowed -->|true| blocked
draftBlockAllowed -->|false| failed
draft -->|on: cancel| cancelled

queued -->|on: hold| draft
queued -->|on: reconcile| depUnsat
depUnsat -->|true| draft
queued -->|on: reconcile| runnable
runnable -->|true| reconcileQueuedClearError
reconcileQueuedClearError --> reconcileQueuedClearReason
reconcileQueuedClearReason --> queued
queued -->|on: dispatch| dispatchable
dispatchable -->|true| dispatchLaunch
dispatchLaunch --> queued
queued -->|on: task.started| startClearError
startClearError --> startClearReason
startClearReason --> running
queued -->|on: review.started| reviewStartClearError
reviewStartClearError --> reviewStartClearReason
reviewStartClearReason --> running
queued -->|on: review.approved| reviewApproveQueuedClearError
reviewApproveQueuedClearError --> reviewApproveQueuedClearReason
reviewApproveQueuedClearReason --> succeeded
queued -->|on: review.changes_required| reviewChangesQueuedClearError
reviewChangesQueuedClearError --> reviewChangesQueuedClearReason
reviewChangesQueuedClearReason --> succeeded
queued -->|on: review.blocked| queuedReviewBlockAllowed
queuedReviewBlockAllowed -->|true| blocked
queuedReviewBlockAllowed -->|false| failed
queued -->|on: block| queuedBlockAllowed
queuedBlockAllowed -->|true| blocked
queuedBlockAllowed -->|false| failed
queued -->|on: fail| failed
queued -->|on: effect.launchTask.failed| failed
queued -->|on: watchdog.failed| failed
queued -->|on: worker.delivery_failed| failed
queued -->|on: worker.start_ack_failed| failed
queued -->|on: worker.platform_failure| platformFallbackQuarantine
platformFallbackQuarantine["action: mutation.quarantinePlatformFailure"]
platformFallbackQuarantine --> failed
queued -->|on: planner.unavailable| plannerUnavailableMark
plannerUnavailableMark --> failed
queued -->|on: execution.orphaned| orphanFailMark
orphanFailMark --> orphanFailClearLease
orphanFailClearLease --> orphanFailClearExecution
orphanFailClearExecution --> failed
queued -->|on: lease.expired| leaseFailQueuedMark
leaseFailQueuedMark --> leaseFailQueuedClearLease
leaseFailQueuedClearLease --> leaseFailQueuedClearExecution
leaseFailQueuedClearExecution --> failed
queued -->|on: cancel| cancelled

running -->|on: interactive.waiting| interactiveWaitAllowed
interactiveWaitAllowed -->|true| runningWaitClearLease
runningWaitClearLease["action: mutation.clearLease"]
runningWaitClearLease --> runningWaitClearExecution
runningWaitClearExecution["action: mutation.clearExecution"]
runningWaitClearExecution --> draft
running -->|on: task.blocked| runningBlockAllowed
runningBlockAllowed -->|true| blocked
runningBlockAllowed -->|false| failed
running -->|on: task.progress| running
running -->|on: review.approved| reviewApproveRunningClearError
reviewApproveRunningClearError --> reviewApproveRunningClearReason
reviewApproveRunningClearReason --> succeeded
running -->|on: review.changes_required| reviewChangesRunningClearError
reviewChangesRunningClearError --> reviewChangesRunningClearReason
reviewChangesRunningClearReason --> succeeded
running -->|on: review.blocked| runningBlockAllowed
running -->|on: task.completed| completeClearError
completeClearError --> completeClearReason
completeClearReason --> succeeded
running -->|on: task.failed| failed
running -->|on: worker.platform_failure| runningPlatformFailureQuarantine
runningPlatformFailureQuarantine["action: mutation.quarantinePlatformFailure"]
runningPlatformFailureQuarantine --> failed
running -->|on: watchdog.failed| failed
running -->|on: planner.failed| plannerRetryAvailable
running -->|on: execution.orphaned| orphanFailMark
plannerRetryAvailable -->|true| plannerRetryClearError
plannerRetryClearError --> plannerRetryClearLease
plannerRetryClearLease --> plannerRetryClearExecution
plannerRetryClearExecution --> queued
plannerRetryAvailable -->|false| plannerFailClearLease
plannerFailClearLease --> plannerFailClearExecution
plannerFailClearExecution --> failed
running -->|on: lease.expired| leaseFailRunningMark
leaseFailRunningMark --> leaseFailRunningClearLease
leaseFailRunningClearLease --> leaseFailRunningClearExecution
leaseFailRunningClearExecution --> failed
running -->|on: task.cancelled| cancelled
running -->|on: pause| queued
running -->|on: cancel| cancelled

blocked -->|on: task.unblocked| unblockAllowed
unblockAllowed -->|true| unblockRetryClearError
unblockAllowed -->|false| blocked
unblockRetryClearError --> unblockRetryClearReason
unblockRetryClearReason --> queued
blocked -->|on: cancel| cancelled

failed -->|on: queue| depSat
failed -->|on: retry| failedRetryClearError
failedRetryClearError --> failedRetryClearReason
failedRetryClearReason --> queued
failed -->|on: task.started| recoverStart
recoverStart -->|true| recoverStartClearError
recoverStartClearError --> recoverStartClearReason
recoverStartClearReason --> running
failed -->|on: task.completed| recoverComplete
recoverComplete -->|true| recoverCompleteClearError
recoverCompleteClearError --> recoverCompleteClearReason
recoverCompleteClearReason --> succeeded
failed -->|on: task.blocked| recoverBlocked
recoverBlocked -->|true| recoverBlockAllowed
recoverBlockAllowed -->|true| blocked
recoverBlockAllowed -->|false| failed
failed -->|on: task.failed| recoverFailed
recoverFailed -->|true| failed
failed -->|on: task.cancelled| recoverCancelled
recoverCancelled -->|true| cancelled
failed -->|on: cancel| cancelled

%% Only a persistent Troubleshooter may reopen a terminal recovery for a new failure episode.
succeeded -->|on: recovery.reopen| troubleshooterRecovery
cancelled -->|on: recovery.reopen| troubleshooterRecovery
troubleshooterRecovery -->|true| recoveryReopenClearError
recoveryReopenClearError --> recoveryReopenClearReason
recoveryReopenClearReason --> recoveryReopenClearLease
recoveryReopenClearLease --> recoveryReopenClearExecution
recoveryReopenClearExecution --> queued
