---
title: Task Resolution
description: Selects and verifies resolution paths for failed or blocked Tasks.
---
flowchart LR
%% relay: initial unresolved
unresolved["state: unresolved"]
checkOwner["state: check_owner"]
checkPath["state: check_path"]
checkFreshExecution["state: check_fresh_execution"]
activeRecovery["action: resolution.activateRecovery"]
sameJob["action: resolution.attachSameJobDependency"]
blockerJob["action: resolution.registerBlockerDependency"]
escalate["action: resolution.createEscalationGate"]
obsolete["action: resolution.cancelSupersede"]
resolved["state: resolved"]
rejected["state: rejected"]
recoveryOwner["guard: recoveryOwnerAvailable"]
plannerOwner["guard: plannerOwnerAvailable"]
exact["guard: exactOriginalRetry"]
same["guard: sameJobDependency"]
fresh["guard: freshRecoveryExecution"]
blocker["guard: blockerJobDependency"]
gate["guard: escalationGate"]
obsoleteGuard["guard: genuinelyObsolete"]
classifiable["guard: classifiableFailure"]
classificationKind["guard: classificationSuperseded"]
classifySuperseded["action: resolution.classifySuperseded"]
classifyInvalid["action: resolution.classifyInvalid"]
supersededEvidence["guard: supersededEvidenceComplete"]
invalidEvidence["guard: invalidEvidenceComplete"]

unresolved -->|on: resolution.propose| checkOwner
checkOwner -->|on: resolution.propose| recoveryOwner
recoveryOwner -->|true| checkPath
recoveryOwner -->|false| plannerOwner
plannerOwner -->|true| checkPath
plannerOwner -->|false| rejected
checkPath -->|on: resolution.propose| fresh
fresh -->|true| checkFreshExecution
fresh -->|false| rejected
checkFreshExecution -->|on: resolution.propose| exact
exact -->|true| activeRecovery
exact -->|false| same
same -->|true| sameJob
same -->|false| blocker
blocker -->|true| blockerJob
blocker -->|false| gate
gate -->|true| escalate
gate -->|false| obsoleteGuard
obsoleteGuard -->|true| obsolete
obsoleteGuard -->|false| rejected
activeRecovery -->|to: resolved| resolved
sameJob -->|to: resolved| resolved
blockerJob -->|to: resolved| resolved
escalate -->|to: resolved| resolved
obsolete -->|to: resolved| resolved
unresolved -->|on: resolution.classify| classifiable
classifiable -->|true| classificationKind
classifiable -->|false| rejected
classificationKind -->|true| supersededEvidence
classificationKind -->|false| invalidEvidence
supersededEvidence -->|true| classifySuperseded
invalidEvidence -->|true| classifyInvalid
classifySuperseded --> resolved
classifyInvalid --> resolved
