---
title: Scheduled Run
description: Controls scheduled-run lifecycle and guarded execution.
---
flowchart LR
%% relay: initial idle
idle["state: idle"]
checkUnclaimed["state: check_unclaimed"]
checkJob["state: check_job"]
checkActive["state: check_active"]
checkConcurrency["state: check_concurrency"]
checkQueue["state: check_queue"]
checkMissed["state: check_missed"]
skipIdempotent["state: skip_idempotent"]
skipActive["state: skip_active"]
claimed["state: claimed"]

slotDue["guard: slotDue"]
slotUnclaimed["guard: slotUnclaimed"]
jobActive["guard: jobActive"]
hasActiveTasks["guard: hasActiveTasks"]
concurrencySkip["guard: concurrencySkip"]
concurrencyQueue["guard: concurrencyQueue"]
runMissed["guard: runMissed"]

skipAdvance["action: schedule.skipActiveAdvance"]
claimFromSlot["action: schedule.claimFromSlot"]
claimFromNow["action: schedule.claimFromNow"]

idle -->|on: schedule.tick| slotDue
slotDue -->|false| skipIdempotent
slotDue -->|true| checkUnclaimed

checkUnclaimed -->|on: schedule.tick| slotUnclaimed
slotUnclaimed -->|false| skipIdempotent
slotUnclaimed -->|true| checkJob

checkJob -->|on: schedule.tick| jobActive
jobActive -->|false| skipIdempotent
jobActive -->|true| checkActive

checkActive -->|on: schedule.tick| hasActiveTasks
hasActiveTasks -->|false| checkMissed
hasActiveTasks -->|true| checkConcurrency

checkConcurrency -->|on: schedule.tick| concurrencySkip
concurrencySkip -->|true| skipAdvance
skipAdvance --> skipActive
concurrencySkip -->|false| checkQueue

checkQueue -->|on: schedule.tick| concurrencyQueue
concurrencyQueue -->|true| skipActive
concurrencyQueue -->|false| checkMissed

checkMissed -->|on: schedule.tick| runMissed
runMissed -->|true| claimFromSlot
claimFromSlot --> claimed
runMissed -->|false| claimFromNow
claimFromNow --> claimed
