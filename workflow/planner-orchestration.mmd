---
title: Planner Orchestration
description: Guards objective-driven planning rounds, interrupted plans, and planner recovery.
---
flowchart LR
%% relay: initial idle
idle["state: idle"]
checkLegacy["state: check_legacy_pending"]
checkRecover["state: check_recover"]
checkPlanFailure["state: check_plan_failure"]
checkPlanRecovery["state: check_plan_recovery"]
checkPlanRecoveryExists["state: check_plan_recovery_exists"]
checkSeed["state: check_seed"]
checkPlanner["state: check_planner"]
checkOptIn["state: check_planner_opt_in"]
checkResolution["state: check_resolution_ownership"]
checkBlocked["state: check_blocked"]
checkWork["state: check_work"]
checkMaterialized["state: check_materialized"]
checkReview["state: check_review"]
wait["state: wait"]
recovered["state: recovered"]
created["state: created"]

legacyPending["guard: legacyPlanningPending"]
recoverablePending["guard: recoverablePendingPlan"]
terminalFailure["guard: terminalPlanFailure"]
recoveryVerified["guard: planRecoveryVerified"]
recoveryExists["guard: planRecoveryExists"]
hasSeed["guard: hasSeedWork"]
planningEnabled["guard: planningRequested"]
noActivePlanner["guard: noActivePlanner"]
resolutionOwned["guard: resolutionOwnedByTroubleshooter"]
noBlocked["guard: noBlockedWork"]
noActiveWork["guard: noActiveImplementation"]
materialized["guard: continuationMaterialized"]
reviewRequired["guard: reviewNeedsReplan"]

recoverAction["action: planner.recoverPending"]
createRecovery["action: planner.createRecovery"]
createAction["action: planner.createRound"]

idle -->|on: planner.reconcile| checkLegacy

checkLegacy -->|on: planner.reconcile| legacyPending
legacyPending -->|true| wait
legacyPending -->|false| checkRecover

checkRecover -->|on: planner.reconcile| recoverablePending
recoverablePending -->|true| recoverAction
recoverAction --> recovered
recoverablePending -->|false| checkPlanFailure

checkPlanFailure -->|on: planner.reconcile| terminalFailure
terminalFailure -->|false| checkSeed
terminalFailure -->|true| checkPlanRecovery

checkPlanRecovery -->|on: planner.reconcile| recoveryVerified
recoveryVerified -->|true| checkPlanner
recoveryVerified -->|false| checkPlanRecoveryExists

checkPlanRecoveryExists -->|on: planner.reconcile| recoveryExists
recoveryExists -->|true| wait
recoveryExists -->|false| createRecovery
createRecovery --> created

checkSeed -->|on: planner.reconcile| hasSeed
hasSeed -->|false| wait
hasSeed -->|true| checkOptIn
checkOptIn -->|on: planner.reconcile| planningEnabled
planningEnabled -->|false| wait
planningEnabled -->|true| checkPlanner

checkPlanner -->|on: planner.reconcile| noActivePlanner
noActivePlanner -->|false| wait
noActivePlanner -->|true| checkResolution

checkResolution -->|on: planner.reconcile| resolutionOwned
resolutionOwned -->|true| wait
resolutionOwned -->|false| checkBlocked

checkBlocked -->|on: planner.reconcile| noBlocked
noBlocked -->|false| wait
noBlocked -->|true| checkWork

checkWork -->|on: planner.reconcile| noActiveWork
noActiveWork -->|false| wait
noActiveWork -->|true| checkMaterialized

checkMaterialized -->|on: planner.reconcile| materialized
materialized -->|false| wait
materialized -->|true| checkReview

checkReview -->|on: planner.reconcile| reviewRequired
reviewRequired -->|false| wait
reviewRequired -->|true| createAction
createAction --> created
