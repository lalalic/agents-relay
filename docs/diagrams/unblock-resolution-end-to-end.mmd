flowchart TD
  blocked["Troubleshooter BLOCKED"]
  source{"Authorized unblock?"}
  reject["Reject without mutation"]
  atomic["Persist unblock baseline and retry evidence"]
  queue["Reset lease and retry same Troubleshooter"]
  wake["Emit wake; Reconciler"]
  guard{"Planner recovery needed?"}
  wait["Wait for durable work or evidence"]
  plan["Create/recover durable Plan"]
  model["Planner reads Job, Tasks and previous Plans"]
  validate{"Hierarchy and progress validation"}
  retry{"Retry budget available?"}
  feedback["Record validation feedback"]
  fail["Plan FAILED; preserve evidence"]
  commit["Commit Plan and children atomically"]
  next["Queue generated Tasks"]
  blocked --> source
  source -->|no| reject
  source -->|yes| atomic --> queue --> wake --> guard
  guard -->|no| wait
  guard -->|yes| plan --> model --> validate
  validate -->|invalid| retry
  retry -->|yes| feedback --> model
  retry -->|no| fail
  validate -->|valid| commit --> next --> wake
